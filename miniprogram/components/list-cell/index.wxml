<view class="cell {{border ? 'cell--border' : ''}}" hover-class="cell--hover" catchtap="onTap">
  <view wx:if="{{icon}}" class="cell__icon" style="background:{{bg}}">
    <ui-icon name="{{icon}}" color="{{color}}" size="{{36}}" />
  </view>
  <view class="cell__body">
    <view class="cell__title">
      <text>{{title}}</text>
      <view wx:if="{{badge}}" class="cell__badge" />
    </view>
    <view wx:if="{{desc}}" class="cell__desc">{{desc}}</view>
  </view>
  <text wx:if="{{value}}" class="cell__value">{{value}}</text>
  <slot />
  <ui-icon wx:if="{{arrow}}" name="right" color="#C4C9D0" size="{{30}}" />
</view>
