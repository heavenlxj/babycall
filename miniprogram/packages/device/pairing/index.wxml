<nav-bar title="连接童话电话" />

<view class="page page--footer page-sky">
  <steps items="{{steps}}" current="{{0}}" />

  <view class="hero">
    <image class="hero__img breath" src="{{images.devicePhone}}" mode="aspectFit" />
    <view class="hero__title">配网前的准备</view>
    <view class="hero__desc">只需几步，角色就能给宝贝打电话啦</view>
  </view>

  <view class="block-title"><text>手机设置</text></view>
  <view class="card checks">
    <view wx:for="{{items}}" wx:key="key" class="check">
      <view class="check__icon check__icon--{{item.status}}">
        <ui-icon name="{{item.icon}}" color="{{item.status === 'fail' ? '#F27B78' : '#67B7F5'}}" size="{{36}}" />
      </view>
      <view class="check__text">
        <view class="check__title">{{item.title}}</view>
        <view class="check__desc">{{item.desc}}</view>
      </view>
      <view wx:if="{{item.status === 'checking'}}" class="spinner" />
      <ui-icon wx:elif="{{item.status === 'ok'}}" name="checkCircle" color="#63C58A" size="{{44}}" fill />
      <view wx:else class="check__fix" data-key="{{item.key}}" bindtap="onFix">去开启</view>
    </view>
  </view>

  <view class="block-title"><text>童话电话</text></view>
  <view class="card guide">
    <view class="guide__item">
      <view class="guide__num">1</view>
      <view>
        <view class="guide__title">打开童话电话</view>
        <view class="guide__desc">长按电源键 3 秒，屏幕亮起小狐表情</view>
      </view>
    </view>
    <view class="guide__item">
      <view class="guide__num">2</view>
      <view>
        <view class="guide__title">进入配网模式</view>
        <view class="guide__desc">同时按住 ★ 和 ♥ 键，听到「滴滴」提示音</view>
      </view>
    </view>
  </view>

  <view class="tips" bindtap="toggleHelp">
    <view class="tips__head">
      <ui-icon name="help" color="#FF9B4A" size="{{32}}" />
      <text>配网小贴士</text>
      <ui-icon name="{{showHelp ? 'down' : 'right'}}" color="#A9B0BA" size="{{28}}" />
    </view>
    <view wx:if="{{showHelp}}" class="tips__body">
      <view>· 手机尽量靠近童话电话（1 米以内）</view>
      <view>· 童话电话仅支持 2.4GHz Wi-Fi，暂不支持 5GHz</view>
      <view>· Wi-Fi 名称和密码中请避免特殊字符</view>
      <view>· 仍然失败？长按电源键 10 秒重启后再试</view>
    </view>
  </view>
</view>

<view class="footer-bar">
  <view wx:if="{{!checking && !allOk}}" class="footer-hint footer-hint--warn">请先开启上面标红的设置</view>
  <btn type="primary" block loading="{{checking}}" disabled="{{checking}}" bindtap="onNext">{{allOk || checking ? '开始搜索设备' : '重新检测'}}</btn>
</view>
